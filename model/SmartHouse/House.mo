within SmartHouse;
model House
  Rooms.UnheatedRoom unheatedRoom
    annotation (Placement(transformation(extent={{-120,64},{-100,84}})));
  Rooms.UnheatedRoom unheatedRoom1
    annotation (Placement(transformation(extent={{-120,-50},{-100,-30}})));
  annotation (Icon(coordinateSystem(preserveAspectRatio=false, extent={{-200,
            -200},{200,200}})), Diagram(coordinateSystem(preserveAspectRatio=
            false, extent={{-200,-200},{200,200}})));
end House;
